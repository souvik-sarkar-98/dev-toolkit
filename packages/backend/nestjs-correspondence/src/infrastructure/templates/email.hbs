                        <tr>
                         <td
                          style="padding:32px 30px; text-align:center;">

                          <!-- Heading -->
                          <div style="
         font-family:{{{@root.theme.headingFontFamily}}};
         color:{{{@root.theme.footerPanelTextColor}}};
         font-size:19px;
         font-weight:700;
         letter-spacing:-0.2px;
         margin-bottom:14px;
        ">
                           {{body.footer.footerPanel.heading}}
                          </div>

                          <!-- Divider -->
                          <table
                           align="center"
                           width="60"
                           cellpadding="0"
                           cellspacing="0"
                           style="margin:0 auto 16px auto;">
                           <tr>
                            <td height="2"
                             style="
            background:{{{@root.theme.footerPanelDividerColor}}};
            line-height:2px;
            font-size:2px;
           ">
                            </td>
                           </tr>
                          </table>

                          <!-- Details -->
                          {{#each
                          body.footer.footerPanel.details}}
                          <div style="
         font-family:{{{@root.theme.fontFamily}}};
         color:{{{@root.theme.footerPanelTextColor}}};
         font-size:15px;
         font-weight:400;
         line-height:1.7;
         margin-bottom:6px;
        ">
                           {{this}}
                          </div>
                          {{/each}}

                         </td>
                        </tr>
                       </tbody>
                      </table>

                     </td>
                    </tr>
                   </tbody>
                  </table>
                  {{/if}}




                  <!-- FINAL FOOTER -->
                  {{#if body.footer.footer}}
                  <table border="0" cellpadding="0"
                   cellspacing="0" align="center" width="100%"
                   role="module" data-type="columns"
                   style="padding:26px 20px;"
                   bgcolor="{{{@root.theme.footerBackground}}}"
                   data-distribution="1">
                   <tbody>
                    <tr role="module-content">
                     <td height="100%" valign="top">
                      <div
                       style="font-family:{{{@root.theme.fontFamily}}}; text-align:center;">
                       <span
                        style="font-size:13px; color:{{{@root.theme.footerTextColor}}}; line-height:1.6;">
                        {{body.footer.footer}}
                       </span>
                      </div>
                     </td>
                    </tr>
                   </tbody>
                  </table>
                  {{/if}}

                 </td>
                </tr>
               </table>

              </td>
             </tr>
            </table>
           </td>
          </tr>
         </table>
        </td>
       </tr>
      </table>
     </td>
    </tr>
   </table>
  </div>
 </center>
</body>

</html>
