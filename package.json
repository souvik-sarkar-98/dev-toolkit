{
  "name": "ssdev-toolkit",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/backend/*",
    "packages/frontend/*",
    "packages/frontend/shared/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf .turbo",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js && turbo run test --filter=./packages/frontend/* && npm run test:frontend-shared",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release:build": "turbo run build",
    "release:publish": "changeset publish",
    "release:ci": "npm run type-check && npm run release:build && npm run release:publish",
    "release": "npm run release:ci",
    "release:beta": "npm run type-check && npm run release:build && changeset publish --tag beta",
    "watch:packages": "turbo watch build"
  },
  "dependencies": {
    "@googleapis/calendar": "^15.0.0",
    "@googleapis/drive": "^20.2.0",
    "@googleapis/gmail": "^17.0.0",
    "@keyv/redis": "^3.0.1",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@onesignal/node-onesignal": "^5.10.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.8.0",
    "auth0": "^5.13.0",
    "aws-cron-parser": "^1.1.12",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.5",
    "bullmq": "^5.79.3",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "cron-parser": "^5.4.0",
    "cronstrue": "^3.21.0",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "expr-eval": "^2.0.2",
    "file-type": "^21.3.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.7.0",
    "handlebars": "^4.7.0",
    "handlebars-helpers": "^0.10.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.0",
    "puppeteer": "^24.36.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.0.1",
