    "@types/compression": "^1.7.0",
    "@types/express": "^4.17.0",
    "@types/handlebars-helpers": "^0.5.6",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.11.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
